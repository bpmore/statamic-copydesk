{
    "name": "bpmore/statamic-copydesk",
    "description": "Readability and plain language checking for Statamic: the reading level of every page as a band against the level you write for, section by section, with what to change, on the publish form, across the site and in CI. Built for health literacy and plain-language mandates. Advisory by default; never a WCAG verdict.",
    "keywords": [
        "statamic",
        "plain-language",
        "readability",
        "health-literacy",
        "iso-24495",
        "flesch-kincaid"
    ],
    "license": "proprietary",
    "type": "statamic-addon",
    "homepage": "https://hada.farm",
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "require": {
        "php": "^8.2",
        "bpmore/readability-core": "^0.2",
        "statamic/cms": "^6.34"
    },
    "require-dev": {
        "bpmore/statamic-site-weather": "^1.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.11 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "suggest": {
        "bpmore/statamic-site-weather": "Shows a Readability band on the Site Weather dashboard tile."
    },
    "repositories": [
        {
            "name": "bpmore-site-weather",
            "type": "path",
            "url": "../statamic-site-weather",
            "options": {
                "symlink": true,
                "versions": {
                    "bpmore/statamic-site-weather": "1.0.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Bpmore\\Copydesk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\Copydesk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "extra": {
        "statamic": {
            "name": "Copydesk",
            "slug": "copydesk",
            "description": "Readability and plain-language checking on the publish form.",
            "editions": [
                "free",
                "pro"
            ]
        },
        "laravel": {
            "providers": [
                "Bpmore\\Copydesk\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
