{
    "name": "bpmore/statamic-plain",
    "description": "Readability and plain-language checking for Statamic: a grade band against your target, per-section grades, and what to fix, on the publish form.",
    "keywords": [
        "statamic",
        "readability",
        "plain-language",
        "health-literacy",
        "flesch-kincaid"
    ],
    "license": "proprietary",
    "type": "statamic-addon",
    "homepage": "https://hada.farm",
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "require": {
        "php": "^8.2",
        "bpmore/readability-core": "^0.1",
        "statamic/cms": "^6.27"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.11 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "repositories": [
        {
            "name": "bpmore-readability-core",
            "type": "path",
            "url": "packages/readability-core",
            "options": {
                "symlink": true,
                "versions": {
                    "bpmore/readability-core": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Bpmore\\Plain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\Plain\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "extra": {
        "statamic": {
            "name": "Plain",
            "slug": "statamic-plain",
            "description": "Readability and plain-language checking on the publish form."
        },
        "laravel": {
            "providers": [
                "Bpmore\\Plain\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
